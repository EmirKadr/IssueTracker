@IssueTracker.Api_HostAddress = https://localhost:9000
@ticketId = 1

GET {{IssueTracker.Api_HostAddress}}/api/tickets
Accept: application/json

###

POST {{IssueTracker.Api_HostAddress}}/api/tickets
Content-Type: application/json
Accept: application/json

{
  "title": "Kan inte logga in",
  "description": "Användaren kan inte logga in i systemet.",
  "priority": "High"
}

###

# Ange ID för ett testärende ovan. Anropet raderar ärendet.
DELETE {{IssueTracker.Api_HostAddress}}/api/tickets/{{ticketId}}

###

# Ange ID för ett befintligt testärende i ticketId. Förväntat: 204.
PUT {{IssueTracker.Api_HostAddress}}/api/tickets/{{ticketId}}
Content-Type: application/json

{
  "title": "Problem med inloggning",
  "description": "Inloggningen fungerar igen efter lösenordsbyte.",
  "status": "Closed",
  "priority": "Normal"
}

###

# Förväntat: 400 med fyra valideringsfel.
PUT {{IssueTracker.Api_HostAddress}}/api/tickets/{{ticketId}}
Content-Type: application/json

{
  "title": "Hej",
  "description": "Kort",
  "status": "Fel",
  "priority": "Fel"
}

###

# Förväntat: 404 eftersom automatiskt genererade ID börjar på 1.
PUT {{IssueTracker.Api_HostAddress}}/api/tickets/0
Content-Type: application/json

{
  "title": "Problem med inloggning",
  "description": "Inloggningen fungerar igen efter lösenordsbyte.",
  "status": "Closed",
  "priority": "Normal"
}

###
